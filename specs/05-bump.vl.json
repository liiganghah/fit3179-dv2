{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart. Rank of Australia's musical-instrument import families, 2015 to 2024.",
  "width": 640,
  "height": 380,
  "background": "#f6f1e7",
  "title": {
    "text": "The electric guitar took the piano's place",
    "subtitle": "Rank 1 is the family Australia spent the most on importing that year. Click a name to follow it.",
    "font": "Fraunces, Georgia, serif",
    "fontSize": 16,
    "fontWeight": 560,
    "anchor": "start",
    "color": "#1c1915",
    "subtitleFont": "Source Sans 3, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5c564c",
    "offset": 12,
    "limit": 800
  },
  "data": {"url": "data/bump.json"},
  "transform": [
    {
      "calculate": "datum.family == 'Electric guitars' || datum.family == 'Acoustic pianos' ? 3.2 : 1.3",
      "as": "weight"
    }
  ],
  "params": [
    {
      "name": "pick",
      "select": {"type": "point", "fields": ["family"]},
      "bind": "legend"
    }
  ],
  "mark": {"type": "line", "point": {"size": 48}},
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {"title": null, "labelAngle": 0}
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": {"domain": [1, 8], "reverse": true},
      "axis": {"tickCount": 8, "format": "d"}
    },
    "color": {
      "field": "family",
      "type": "nominal",
      "title": null,
      "sort": ["Electric guitars", "Acoustic pianos", "Electric keyboards", "Acoustic guitars", "Other wind", "Percussion", "Bowed strings", "Brass"],
      "scale": {
        "domain": ["Electric guitars", "Acoustic pianos", "Electric keyboards", "Acoustic guitars", "Other wind", "Percussion", "Bowed strings", "Brass"],
        "range": ["#9a3b2f", "#2f5d50", "#c46b4a", "#5d8a78", "#3d5a80", "#c4a35a", "#6b5b7a", "#8a8175"]
      },
      "legend": {"orient": "right", "columns": 1, "labelLimit": 160}
    },
    "strokeWidth": {"field": "weight", "type": "quantitative", "legend": null},
    "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.15},
    "tooltip": [
      {"field": "family", "title": "Family"},
      {"field": "year", "title": "Year"},
      {"field": "rank", "title": "Rank"},
      {"field": "usd_million", "title": "US$ million", "format": ".1f"}
    ]
  },
  "config": {
    "font": "Source Sans 3, sans-serif",
    "axis": {"labelColor": "#3d3832", "titleColor": "#5c564c", "gridColor": "#e4ddd0", "domainColor": "#c9c0b2", "labelFontSize": 12, "titleFontSize": 13},
    "legend": {"labelColor": "#1c1915", "labelFontSize": 12},
    "view": {"stroke": null}
  }
}
