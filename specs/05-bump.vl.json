{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart. Rank of Australia's musical-instrument import families, 2015 to 2024.",
  "width": "container",
  "height": 300,
  "padding": {"left": 2, "right": 4, "top": 4, "bottom": 16},
  "autosize": {"type": "fit-x", "contains": "padding", "resize": true},
  "background": "#f6f1e7",
  "title": {
    "text": ["The electric guitar took", "the piano's place"],
    "subtitle": ["Rank 1 is the largest import bill that year.", "Click a name to follow that family."],
    "font": "Fraunces, Georgia, serif",
    "fontSize": 16,
    "fontWeight": 560,
    "anchor": "start",
    "color": "#1c1915",
    "subtitleFont": "Source Sans 3, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5c564c",
    "offset": 12,
    "limit": 2000
  },
  "data": {"url": "data/bump.json"},
  "transform": [
    {
      "calculate": "datum.family == 'Electric guitars' || datum.family == 'Acoustic pianos' ? 3.2 : 1.3",
      "as": "weight"
    }
  ],
  "layer": [
  {
  "params": [
    {
      "name": "pick",
      "select": {"type": "point", "fields": ["family"]},
      "bind": "legend"
    }
  ],
  "mark": {"type": "line", "point": {"size": 48}},
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "scale": {"padding": 0.05},
      "axis": {"title": null, "labelAngle": -45, "labelAlign": "right", "labelBaseline": "middle", "labelOverlap": false, "labelFontSize": 11, "labelPadding": 2}
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": {"domain": [1, 8], "reverse": true},
      "axis": {"tickCount": 8, "format": "d"}
    },
    "color": {
      "field": "family",
      "type": "nominal",
      "title": null,
      "sort": ["Electric guitars", "Acoustic pianos", "Electric keyboards", "Acoustic guitars", "Other wind", "Percussion", "Bowed strings", "Brass"],
      "scale": {
        "domain": ["Electric guitars", "Acoustic pianos", "Electric keyboards", "Acoustic guitars", "Other wind", "Percussion", "Bowed strings", "Brass"],
        "range": ["#a52d09", "#1d3156", "#496894", "#8e5815", "#3f4a68", "#6c581d", "#2d2a0f", "#8d4a3c"]
      },
      "legend": {"orient": "bottom", "columns": 2, "columnPadding": 36, "labelLimit": 0}
    },
    "strokeWidth": {"field": "weight", "type": "quantitative", "legend": null},
    "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.15},
    "tooltip": [
      {"field": "family", "title": "Family"},
      {"field": "year", "title": "Year"},
      {"field": "rank", "title": "Rank"},
      {"field": "usd_million", "title": "US$ million", "format": ".1f"}
    ]
  }
  },
  {
    "transform": [{"filter": "datum.year == 2024"}],
    "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 9, "fontSize": 11, "fontWeight": 700},
    "encoding": {
      "x": {"field": "year", "type": "ordinal"},
      "y": {"field": "rank", "type": "quantitative", "scale": {"domain": [1, 8], "reverse": true}},
      "text": {"field": "family", "type": "nominal"},
      "color": {
        "field": "family",
        "type": "nominal",
        "scale": {
          "domain": ["Electric guitars", "Acoustic pianos", "Electric keyboards", "Acoustic guitars", "Other wind", "Percussion", "Bowed strings", "Brass"],
          "range": ["#a52d09", "#1d3156", "#496894", "#8e5815", "#3f4a68", "#6c581d", "#2d2a0f", "#8d4a3c"]
        },
        "legend": null
      },
      "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.15}
    }
  }
  ],
  "config": {
    "font": "Source Sans 3, sans-serif",
    "axis": {"labelColor": "#3d3832", "titleColor": "#5c564c", "gridColor": "#e4ddd0", "domainColor": "#c9c0b2", "labelFontSize": 12, "titleFontSize": 13},
    "legend": {"labelColor": "#1c1915", "labelFontSize": 12},
    "view": {"stroke": null}
  }
}
