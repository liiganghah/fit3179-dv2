{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart. Children's participation in creative activities, 2017–18 and 2021–22.",
  "width": "container",
  "height": 360,
  "padding": {"left": 4, "right": 112, "top": 4, "bottom": 4},
  "autosize": {"type": "fit-x", "contains": "padding", "resize": true},
  "background": "#f6f1e7",
  "title": {
    "text": ["Music slipped, and most", "other activities did too"],
    "subtitle": ["Percent of children aged 5 to 14", "who took part outside school hours."],
    "font": "Fraunces, Georgia, serif",
    "fontSize": 16,
    "fontWeight": 560,
    "anchor": "start",
    "color": "#1c1915",
    "subtitleFont": "Source Sans 3, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5c564c",
    "offset": 12,
    "limit": 2000
  },
  "data": {"url": "data/slope.json"},
  "layer": [
    {
      "params": [
        {
          "name": "pick",
          "select": {"type": "point", "fields": ["activity"]},
          "bind": "legend"
        }
      ],
      "mark": {"type": "line", "point": {"size": 80}, "interpolate": "linear"},
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {"title": null, "labelAngle": 0, "domain": false, "ticks": false, "labelFontSize": 13, "labelPadding": 8},
          "scale": {"padding": 0.45}
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "title": "Percent of children",
          "scale": {"domain": [0, 46]},
          "axis": {"tickCount": 5, "grid": true}
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Singing or playing", "Art and craft", "Creative writing", "Dancing", "Creating digital content", "Drama"],
            "range": ["#a52d09", "#6c581d", "#6c6b80", "#3f4a68", "#496894", "#2d2a0f"]
          },
          "legend": {"orient": "bottom", "columns": 2, "columnPadding": 48, "labelLimit": 0}
        },
        "strokeWidth": {
          "condition": {"test": "datum.activity == 'Singing or playing'", "value": 3.6},
          "value": 2
        },
        "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.18},
        "tooltip": [
          {"field": "activity", "title": "Activity"},
          {"field": "year", "title": "Year"},
          {"field": "pct", "title": "Percent", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.year == '2021–22' && datum.activity != 'Singing or playing' && datum.activity != 'Creative writing'"},
        {"calculate": "datum.activity == 'Art and craft' ? 'Art and craft  ' + format(datum.pct, '.1f') : datum.activity == 'Creating digital content' ? 'Digital  ' + format(datum.pct, '.1f') : datum.activity == 'Dancing' ? 'Dancing  ' + format(datum.pct, '.1f') : 'Drama  ' + format(datum.pct, '.1f')", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 10, "fontSize": 11, "fontWeight": 700},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "scale": {"padding": 0.45}},
        "y": {"field": "pct", "type": "quantitative", "scale": {"domain": [0, 46]}},
        "text": {"field": "tag", "type": "nominal"},
        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": ["Singing or playing", "Art and craft", "Creative writing", "Dancing", "Creating digital content", "Drama"],
            "range": ["#a52d09", "#6c581d", "#6c6b80", "#3f4a68", "#496894", "#2d2a0f"]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.year == '2021–22' && datum.activity == 'Singing or playing'"},
        {"calculate": "'Music  ' + format(datum.pct, '.1f')", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 10, "dy": -12, "fontSize": 11, "fontWeight": 700, "fill": "#a52d09"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "scale": {"padding": 0.45}},
        "y": {"field": "pct", "type": "quantitative", "scale": {"domain": [0, 46]}},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "transform": [
        {"filter": "datum.year == '2021–22' && datum.activity == 'Creative writing'"},
        {"calculate": "'Writing  ' + format(datum.pct, '.1f')", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 10, "dy": 2, "fontSize": 11, "fontWeight": 700, "fill": "#6c6b80"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "scale": {"padding": 0.45}},
        "y": {"field": "pct", "type": "quantitative", "scale": {"domain": [0, 46]}},
        "text": {"field": "tag", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Source Sans 3, sans-serif",
    "axis": {"labelColor": "#3d3832", "titleColor": "#5c564c", "gridColor": "#e4ddd0", "domainColor": "#c9c0b2", "labelFontSize": 12, "titleFontSize": 13},
    "legend": {"labelColor": "#1c1915", "labelFontSize": 13},
    "view": {"stroke": null}
  }
}
