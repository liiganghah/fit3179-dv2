{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map. Value of musical instruments imported by Australia in 2024, by origin.",
  "width": "container",
  "height": 320,
  "autosize": {"type": "fit-x", "contains": "padding", "resize": true},
  "background": "#f6f1e7",
  "title": {
    "text": "Four countries supply most of the imports",
    "subtitle": ["Circle area is the 2024 import value.", "Equal Earth. Origins under US$1 million are left off."],
    "font": "Fraunces, Georgia, serif",
    "fontSize": 16,
    "fontWeight": 560,
    "anchor": "start",
    "color": "#1c1915",
    "subtitleFont": "Source Sans 3, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5c564c",
    "offset": 12,
    "limit": 2000
  },
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "data/geo/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e7e0d4", "stroke": "#f6f1e7", "strokeWidth": 0.4}
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [{"filter": "datum.usd_million >= 1 && datum.iso3 != ''"}],
      "mark": {"type": "circle", "fill": "#9a3b2f", "fillOpacity": 0.78, "stroke": "#f6f1e7", "strokeWidth": 0.6},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "value_usd",
          "type": "quantitative",
          "title": "Import value",
          "scale": {"domain": [1000000, 40000000], "range": [80, 1200]},
          "legend": {"orient": "bottom", "direction": "horizontal", "format": "$,.0f", "title": "US dollars"}
        },
        "tooltip": [
          {"field": "partner", "title": "Origin"},
          {"field": "usd_million", "title": "US$ million", "format": ".1f"},
          {"field": "top_family", "title": "Largest family on this route"},
          {"field": "top_share", "title": "Share of that origin, percent", "format": ".0f"}
        ]
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'China'"},
        {"calculate": "'China\\n$' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -8, "dy": 4, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif", "lineHeight": 13},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "indexof(['USA','Japan','Germany'], datum.partner) >= 0"},
        {"calculate": "datum.partner + '\\n$' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"},
        {"calculate": "datum.partner == 'Japan' ? -16 : datum.partner == 'Germany' ? -12 : -6", "as": "dy"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif", "lineHeight": 13},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "dy": {"field": "dy", "type": "quantitative", "scale": null},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'Indonesia'"},
        {"calculate": "'Indonesia\\n$' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "center", "dy": 16, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif", "lineHeight": 13},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'Malaysia'"},
        {"calculate": "'Malaysia\\n$' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 8, "dy": -14, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif", "lineHeight": 13},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Source Sans 3, sans-serif",
    "legend": {"labelColor": "#3d3832", "titleColor": "#5c564c"},
    "view": {"stroke": null}
  }
}
