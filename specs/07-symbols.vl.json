{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map. Value of musical instruments imported by Australia in 2024, by origin.",
  "width": "container",
  "height": 330,
  "autosize": {"type": "fit-x", "contains": "padding", "resize": true},
  "background": "#f6f1e7",
  "title": {
    "text": ["Four countries supply", "most of the imports"],
    "subtitle": ["Circle area is the 2024 import value.", "The $8m, $20m and $40m ticks match Figure 11."],
    "font": "Fraunces, Georgia, serif",
    "fontSize": 16,
    "fontWeight": 560,
    "anchor": "start",
    "color": "#1c1915",
    "subtitleFont": "Source Sans 3, sans-serif",
    "subtitleFontSize": 13,
    "subtitleColor": "#5c564c",
    "offset": 12,
    "limit": 2000
  },
  "projection": {"type": "equalEarth", "rotate": [-150, 0]},
  "layer": [
    {
      "data": {
        "url": "data/geo/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {"type": "geoshape", "fill": "#e7e0d4", "stroke": "#f6f1e7", "strokeWidth": 0.4}
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [{"filter": "datum.usd_million >= 1 && datum.iso3 != ''"}],
      "mark": {"type": "circle", "fill": "#c7370b", "fillOpacity": 0.9, "stroke": "#f6f1e7", "strokeWidth": 0.6},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "value_usd",
          "type": "quantitative",
          "title": "Import value",
          "scale": {"domain": [1000000, 40000000], "range": [28, 700]},
          "legend": {"orient": "bottom", "direction": "horizontal", "format": "$.2s", "title": "Circle area", "values": [8000000, 20000000, 40000000], "labelLimit": 0}
        },
        "tooltip": [
          {"field": "partner", "title": "Origin"},
          {"field": "usd_million", "title": "US$ million", "format": ".1f"},
          {"field": "top_family", "title": "Largest family on this route"},
          {"field": "top_share", "title": "Share of that origin, percent", "format": ".0f"}
        ]
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'China'"},
        {"calculate": "'China  $' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -18, "dy": -12, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'Japan'"},
        {"calculate": "'Japan  $' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 12, "dy": -12, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'USA'"},
        {"calculate": "'United States  $' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -12, "dy": -16, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'Germany'"},
        {"calculate": "'Germany  $' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -10, "dy": -14, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'Malaysia'"},
        {"calculate": "'Malaysia  $' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "right", "dx": -12, "dy": -16, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    },
    {
      "data": {"url": "data/origins.json"},
      "transform": [
        {"filter": "datum.partner == 'Indonesia'"},
        {"calculate": "'Indonesia  $' + format(datum.usd_million, '.0f') + 'm'", "as": "tag"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 12, "dy": 4, "fontSize": 11, "fontWeight": 700, "fill": "#1c1915", "font": "Source Sans 3, sans-serif"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "tag", "type": "nominal"}
      }
    }
  ],
  "config": {
    "font": "Source Sans 3, sans-serif",
    "legend": {"labelColor": "#3d3832", "titleColor": "#5c564c"},
    "view": {"stroke": null}
  }
}
